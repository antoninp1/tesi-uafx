[Unit]
Description=UAFX Local Discovery Server (LDS)
Documentation=https://github.com/antoninp1/tesi-uafx
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uafx
Group=uafx
WorkingDirectory=/opt/uafx

ExecStart=/opt/uafx/bin/lds /opt/uafx/certs

Restart=on-failure
RestartSec=5s

# Security hardening
# CAP_NET_BIND_SERVICE: allows binding to port 4850 (and any port < 1024
# if the port is ever changed). Not strictly required for ports > 1024
# but kept for forward compatibility.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/uafx/certs

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lds_server

[Install]
WantedBy=multi-user.target
