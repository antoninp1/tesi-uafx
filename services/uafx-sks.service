[Unit]
Description=UAFX Security Key Service (SKS)
Documentation=https://github.com/antoninp1/tesi-uafx
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uafx
Group=uafx
WorkingDirectory=/opt/uafx

ExecStart=/opt/uafx/bin/sks /opt/uafx/certs/sks_server.cert.der /opt/uafx/certs/sks_server.key.der /opt/uafx/certs/lds_server.cert.der --trustlist /opt/uafx/certs/publisher.cert.der /opt/uafx/certs/subscriber.cert.der

Restart=on-failure
RestartSec=5s

# Security hardening
# CAP_NET_BIND_SERVICE: allows binding to port 4850 (and any port < 1024
# if the port is ever changed). Not strictly required for ports > 1024
# but kept for forward compatibility.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/uafx/certs

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sks_server

[Install]
WantedBy=multi-user.target
